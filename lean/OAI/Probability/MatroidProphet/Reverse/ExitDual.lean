def exitProfile (x : ℝ) : ℝ := x * (11 / 20 - x) / (1 - x)
def exitThresholdAt (i : ℕ) : ℝ := (1 / 4 : ℝ) * (16 / 19 : ℝ) ^ i
def exitLevel (i : ℕ) : ℝ := exitProfile (exitThresholdAt i)
def exitWeight (i : ℕ) : ℝ :=
  if i = 0 then 217 / 2000 - exitLevel 0
  else if i < 57 then exitLevel (i - 1) - exitLevel i
  else exitLevel 56
def exitCertificate (x : ℝ) : ℝ :=
  ∑ i ∈ range 58, exitWeight i * (if exitThresholdAt i ≤ x then 1 else 0)
lemma exitProfile_mono {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1 / 4) :
    11 / 20 * x - x ^ 2 ≤ (1 - x) * exitProfile y := by
  unfold exitProfile
  have hy1 : 0 < 1 - y := by linarith
  rw [mul_div_assoc', le_div_iff₀ hy1]
  have h1 : 0 ≤ y - x := by linarith
  have h2 : 0 ≤ 11 / 20 - x - y + x * y := by nlinarith
  nlinarith [mul_nonneg h1 h2]
lemma exitThreshold_mono (i : ℕ) : exitThresholdAt (i + 1) ≤ exitThresholdAt i := by
  unfold exitThresholdAt
  rw [pow_succ]
  gcongr
  apply mul_le_of_le_one_right (by positivity)
  norm_num
lemma exitThreshold_antitone {i j : ℕ} (hij : i ≤ j) :
    exitThresholdAt j ≤ exitThresholdAt i := by
  induction j, hij using Nat.le_induction with
  | base => exact le_rfl
  | succ j hj ih => exact (exitThreshold_mono j).trans ih
